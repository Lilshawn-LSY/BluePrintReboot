{
  "name": "BluePrintReboot",

  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },

  "forwardPorts": [
    3000,
    8000,
    8501
  ],

  "portsAttributes": {
    "3000": {
      "label": "BluePrint Frontend"
    },
    "8000": {
      "label": "BluePrint FastAPI"
    },
    "8501": {
      "label": "BluePrint Streamlit"
    }
  },

  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt -r requirements-optional.txt && npm ci --prefix frontend",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
